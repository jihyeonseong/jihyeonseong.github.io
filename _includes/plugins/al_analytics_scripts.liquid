{% comment %}
  al_folio_core 의 _includes/plugins/al_analytics_scripts.liquid 를 로컬에서 덮어쓴 것이다.
  원본은 al_analytics_scripts 태그 한 줄뿐이다 — 그 줄은 그대로 두고 GoatCounter 만 덧붙였다.
  al_analytics gem 이 GoatCounter 를 지원하지 않아서다. scripts.liquid 가 부르므로 모든 페이지에 붙는다.

  1) 수집: count.js. production 빌드에서만 넣는다 — 로컬 프리뷰 방문이 조회수에 섞이지 않게.
  2) 표시: GoatCounter 의 counter JSON API 로 숫자만 읽어온다(읽기는 방문으로 세지 않는다).
     - 글 제목 아래 날짜 줄 끝에 "N views" (그 글의 누적)
     - 푸터 끝에 "N total views" (사이트 전체 누적, 경로 TOTAL)
     JSON API 는 날짜 범위를 지원하지 않아 누적만 된다. 일일 조회수는 GoatCounter 대시보드에서 본다.
     GoatCounter 설정의 "Allow adding visitor counts on your website" 가 켜져 있어야 한다.
     숫자는 GoatCounter 의 visit 기준이다 — 같은 사람이 새로고침한 것은 한 번으로 센다.

  코드명은 _config.yml 의 analytics.goatcounter.
  gem 을 올릴 때는
  `bundle exec al-folio upgrade overrides diff _includes/plugins/al_analytics_scripts.liquid`
  로 원본이 바뀌었는지 확인한다.
{% endcomment %}
{% al_analytics_scripts %}
{% if site.analytics.goatcounter %}
  {% if jekyll.environment == 'production' %}
    <!-- GoatCounter -->
    <script
      data-goatcounter="https://{{ site.analytics.goatcounter }}.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  {% endif %}
  <style>
    /* 사이트 CSS 가 span 에 본문 색을 강제한다 — 부모(날짜 줄·푸터) 색을 따르게 한다 */
    .gc-views,
    .gc-total {
      color: inherit !important;
    }
  </style>
  <script>
    (function () {
      var BASE = "https://{{ site.analytics.goatcounter }}.goatcounter.com/counter/";

      // 기록이 없는 경로는 404 지만 본문이 {"count":"0"} 이다. 실패하면 아무것도 안 붙인다.
      function fetchCount(path) {
        return fetch(BASE + encodeURIComponent(path) + ".json")
          .then(function (r) {
            return r.json();
          })
          .then(function (d) {
            return d && typeof d.count === "string" ? d.count : null;
          })
          .catch(function () {
            return null;
          });
      }

      function append(el, text, cls) {
        var s = document.createElement("span");
        s.className = cls;
        s.textContent = " · " + text;
        el.appendChild(s);
      }

      var footer = document.querySelector("footer .container");
      if (footer) {
        fetchCount("TOTAL").then(function (c) {
          if (c !== null) append(footer, c + " total views", "gc-total");
        });
      }

      {% if page.layout == 'post' %}
        var meta = document.querySelector(".post-meta");
        if (meta) {
          fetchCount(location.pathname).then(function (c) {
            if (c !== null) append(meta, c + (c === "1" ? " view" : " views"), "gc-views");
          });
        }
      {% endif %}
    })();
  </script>
{% endif %}
