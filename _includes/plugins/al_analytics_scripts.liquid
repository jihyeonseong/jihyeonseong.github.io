{% comment %}
  al_folio_core 의 _includes/plugins/al_analytics_scripts.liquid 를 로컬에서 덮어쓴 것이다.
  원본은 al_analytics_scripts 태그 한 줄뿐이다 — 그 줄은 그대로 두고 GoatCounter 만 덧붙였다.
  al_analytics gem 이 GoatCounter 를 지원하지 않아서다. scripts.liquid 가 부르므로 모든 페이지에 붙는다.

  1) 수집: count.js. production 빌드에서만 넣는다 — 로컬 프리뷰 방문이 조회수에 섞이지 않게.
  2) 표시: GoatCounter 의 counter JSON API 로 숫자만 읽어온다(읽기는 방문으로 세지 않는다).
     - 글 제목 아래 날짜 줄 끝에 "N views" (그 글의 누적) — 자동
     - 페이지에 자리를 두면 채운다:
         <span data-gc-total data-gc-format="{n} visit{s}" hidden></span>   사이트 전체 누적(TOTAL)
         <span data-gc-sum="/a/,/b/" data-gc-format="{n} view{s}" hidden></span>  나열한 경로들의 합
       {n} 은 숫자(1,234), {s} 는 1 이 아니면 "s". 채울 때 hidden 을 푼다.
       지금 쓰는 곳: _pages/about.md(사이트 합계), _pages/blog.md(모든 글 합).
     JSON API 는 날짜 범위를 지원하지 않아 누적만 된다. 일일 조회수는 GoatCounter 대시보드에서 본다.
     data-gc-sum 은 경로마다 요청을 하나씩 보낸다 — 글이 아주 많아지면 블로그 첫 화면이 느려질 수 있다.
     GoatCounter 설정의 "Allow adding visitor counts on your website" 가 켜져 있어야 한다.
     숫자는 GoatCounter 의 visit 기준이다 — 같은 사람이 새로고침한 것은 한 번으로 센다.

  코드명은 _config.yml 의 analytics.goatcounter.
  gem 을 올릴 때는
  `bundle exec al-folio upgrade overrides diff _includes/plugins/al_analytics_scripts.liquid`
  로 원본이 바뀌었는지 확인한다.
{% endcomment %}
{% al_analytics_scripts %}
{% if site.analytics.goatcounter %}
  {% if jekyll.environment == 'production' %}
    <!-- GoatCounter -->
    <script
      data-goatcounter="https://{{ site.analytics.goatcounter }}.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  {% endif %}
  <style>
    /* 사이트 CSS 가 span 에 본문 색을 강제한다 — 부모(날짜 줄·푸터) 색을 따르게 한다 */
    .gc-views {
      color: inherit !important;
    }
    [data-gc-total],
    [data-gc-sum] {
      color: var(--global-text-color-light) !important;
      font-size: 0.85rem;
    }
  </style>
  <script>
    (function () {
      var BASE = "https://{{ site.analytics.goatcounter }}.goatcounter.com/counter/";

      // 기록이 없는 경로는 404 지만 본문이 {"count":"0"} 이다. 실패하면 아무것도 안 붙인다.
      function fetchCount(path) {
        return fetch(BASE + encodeURIComponent(path) + ".json")
          .then(function (r) {
            return r.json();
          })
          .then(function (d) {
            return d && typeof d.count === "string" ? d.count : null;
          })
          .catch(function () {
            return null;
          });
      }

      function append(el, text, cls) {
        var s = document.createElement("span");
        s.className = cls;
        s.textContent = " · " + text;
        el.appendChild(s);
      }

      function toNumber(c) {
        return parseInt(String(c).replace(/[^0-9]/g, ""), 10) || 0;
      }

      function fill(el, n) {
        var fmt = el.getAttribute("data-gc-format") || "{n}";
        el.textContent = fmt.replace("{n}", n.toLocaleString("en-US")).replace("{s}", n === 1 ? "" : "s");
        el.hidden = false;
      }

      document.querySelectorAll("[data-gc-total]").forEach(function (el) {
        fetchCount("TOTAL").then(function (c) {
          if (c !== null) fill(el, toNumber(c));
        });
      });

      document.querySelectorAll("[data-gc-sum]").forEach(function (el) {
        var paths = el.getAttribute("data-gc-sum").split(",").filter(Boolean);
        if (!paths.length) return;
        Promise.all(paths.map(fetchCount)).then(function (counts) {
          var got = counts.filter(function (c) {
            return c !== null;
          });
          if (!got.length) return;
          fill(el, got.reduce(function (sum, c) {
            return sum + toNumber(c);
          }, 0));
        });
      });

      {% if page.layout == 'post' %}
        var meta = document.querySelector(".post-meta");
        if (meta) {
          fetchCount(location.pathname).then(function (c) {
            if (c !== null) append(meta, c + (c === "1" ? " view" : " views"), "gc-views");
          });
        }
      {% endif %}
    })();
  </script>
{% endif %}
